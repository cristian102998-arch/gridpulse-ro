# Copy to deploy/app.env on the server. Never commit the real file.
# Only the public Streamlit app reads this; the pipeline uses deploy/.env.

# Read-only role from deploy/create_readonly_role.sql, not the owner URL.
DATABASE_URL=postgresql://gridpulse_app:PASSWORD@HOST/gridpulse?sslmode=require

# Live chat (optional). Without the key the Chat page shows only the cached examples.
ANTHROPIC_API_KEY=
# Salt for hashing visitors in the chat log. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_LOG_SALT=
