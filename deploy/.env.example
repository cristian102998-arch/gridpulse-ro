# Copy to deploy/.env on the server. Never commit the real file.

# Warehouse (Neon). Copy the connection string from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/gridpulse?sslmode=require
GRIDPULSE_RAW_ROOT=/opt/airflow/data/raw
# Until Azure Blob is set up, nightly backups stay on the VM volume.
GRIDPULSE_BACKUP_ROOT=/opt/airflow/data/backups

# Public hostname served by Caddy (A record in Vercel DNS -> VM IP).
GRIDPULSE_DOMAIN=gridpulse.naya-hub.com

# Airflow internals. Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me
# Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me

# Alerts (optional). Without them, alerts only go to the logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ENTSO-E (once the token arrives)
ENTSOE_TOKEN=

# Azure Blob (from week 2). Raw zone + nightly backups. A service principal with
# "Storage Blob Data Contributor" on this one storage account only.
# GRIDPULSE_RAW_ROOT=abfs://raw
# GRIDPULSE_BACKUP_ROOT=abfs://backups
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_TENANT_ID=
AZURE_STORAGE_CLIENT_ID=
AZURE_STORAGE_CLIENT_SECRET=
