# Airflow 3 + the gridpulse CLI and dbt in their own virtualenv.
# A separate venv keeps dbt's pinned dependencies away from Airflow's constraints.
FROM apache/airflow:3.3.2-python3.12

USER root
COPY --chown=airflow:root . /opt/gridpulse-src
# Mount point of the raw-data volume. A new named volume copies this ownership,
# otherwise it is root-owned and the airflow user cannot write raw files or backups.
RUN mkdir -p /opt/airflow/data && chown airflow:root /opt/airflow/data
# LightGBM links against OpenMP at import time.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
USER airflow

RUN python -m venv /opt/airflow/gridpulse-venv \
    && /opt/airflow/gridpulse-venv/bin/pip install --no-cache-dir /opt/gridpulse-src

ENV PATH="/opt/airflow/gridpulse-venv/bin:${PATH}" \
    GRIDPULSE_DBT_DIR=/opt/gridpulse-src/dbt
